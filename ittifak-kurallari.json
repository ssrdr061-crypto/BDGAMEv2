// ═══════════════════════════════════════════════════════════════════
//  İTTİFAK — FIREBASE VERİTABANI KURALI
//
//  ⚠️  BU DOSYA TAM BİR KURAL SETİ DEĞİLDİR. Firebase Console'daki
//      kuralların YERİNE YAPIŞTIRMA — sadece aşağıdaki "ittifaklar"
//      bloğunu var olan kuralların İÇİNE EKLE.
//      (Kurulum adımları: ITTIFAK-KURULUM.md)
//
//  NEDEN GEREKLİ
//  ittifak.js `ittifaklar/{etiket}` düğümüne yazıyor. Realtime
//  Database'de hiçbir kuralın kapsamadığı düğüme yazma varsayılan
//  olarak reddedilir. Belirtisi tam olarak şudur: "İttifak Kur"a
//  basınca "Kurulamadı: PERMISSION_DENIED".
//
//  VERİ BİÇİMİ (ittifak.js ile birebir)
//  ittifaklar/{id} = {
//    ad, adKucuk, etiket, manifesto,
//    katilim: "aninda" | "basvuru",
//    kurucu, kurulus,
//    uyeler:     { oyuncuAnahtari: { ad, rutbe, at } },
//    basvurular: { oyuncuAnahtari: { ad, at } }
//  }
//  id = etiketin küçük harfli hâli; benzersizliği düğüm adı korur.
// ═══════════════════════════════════════════════════════════════════
{
  "ittifaklar": {

    // Okuma HERKESE AÇIK, bilerek.
    // Sebep: sayfa yenilendiğinde Firebase Auth oturumu geri
    // yüklemesi ASENKRONDUR — o birkaç yüz milisaniyede
    // auth hâlâ null görünür. Sıralama paneli tam o anda
    // açılırsa "auth != null" kuralı listeyi boş gösterirdi.
    // İttifak adı/etiketi zaten gizli bilgi değil.
    ".read": true,

    "$id": {

      // Yazma yalnız giriş yapmış oyuncuya. Rütbe denetimi
      // (kim atabilir, kim dağıtabilir) İSTEMCİDE yapılır.
      //
      // ⚠️ BURAYA "yalnız kurucu dağıtabilir" KURALI YAZMAYI DENEME.
      // Denendi, ÇALIŞMIYOR. Sebebi ölçüldü:
      //   üye anahtarı  = toFirebaseKey(ad)  → encodeURIComponent
      //                   BÜYÜK harfli hex üretir:  ay%C5%9Fe
      //   auth.token.email  → Firebase e-postayı KÜÇÜK harfe çevirir
      //                   ...@bdgame.local'dan çıkan: ay%c5%9fe
      // "Ahmet" gibi ASCII adlarda ikisi eşleşir, ama "Ayşe",
      // "Çağrı", "Gökhan", "İbrahim" gibi TÜRKÇE karakterli her adda
      // eşleşmez. Böyle bir kural, oyuncuların çoğunda "İttifakı
      // Dağıt" düğmesini sessizce kilitlerdi.
      // Karşılığında kabul edilen risk: giriş yapmış bir oyuncu,
      // ham Firebase çağrısıyla başkasının ittifakını silebilir.
      // Oyun arayüzünden bu mümkün değildir.
      ".write": "auth != null",

      // Yeni ittifak kaydı en azından bu alanları taşımalı.
      // Silmede (newData yok) doğrulama çalışmaz.
      ".validate": "!newData.exists() || newData.hasChildren(['ad','etiket','kurucu','uyeler'])",

      // ── ALAN DOĞRULAMALARI ─────────────────────────────────────
      // BİLEREK GEVŞEK: bu projede daha önce castles/ altında
      // alanları tek tek sayan kurallar yüzünden iki kez
      // PERMISSION_DENIED yaşandı (yeni "sv" ve "kb" alanları
      // eklenince TÜM yazma düşüyordu — bkz. index.html
      // publishCastle yorumları). Bu yüzden burada "$other": false
      // YOKTUR: ittifak.js'e yarın yeni bir alan eklenirse yazma
      // sessizce reddedilmez, çalışmaya devam eder.
      "ad":        { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 16" },
      "adKucuk":   { ".validate": "newData.isString()" },
      "etiket":    { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 4" },
      "manifesto": { ".validate": "newData.isString() && newData.val().length <= 120" },
      "katilim":   { ".validate": "newData.val() === 'aninda' || newData.val() === 'basvuru'" },
      "kurucu":    { ".validate": "newData.isString()" },
      "kurulus":   { ".validate": "newData.isNumber()" },

      "uyeler": {
        "$uye": {
          "ad":    { ".validate": "newData.isString()" },
          "rutbe": { ".validate": "newData.val() === 'kurucu' || newData.val() === 'subay' || newData.val() === 'uye'" },
          "at":    { ".validate": "newData.isNumber()" }
        }
      },

      "basvurular": {
        "$bas": {
          "ad": { ".validate": "newData.isString()" },
          "at": { ".validate": "newData.isNumber()" }
        }
      }
    }
  }
}
